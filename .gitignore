*.pt
*.onnx
!docs/model/*.onnx
checkpoints/
runs/
*.log
*.err

# Derived features and fitted baselines (regenerate with the baseline scripts)
experiments/landmarks/
experiments/dino_probe/*.npz
experiments/svm_final_eval/*.joblib

# Local only
.archive/
